add_atom(x = p1$atoms$x[10] - 0.5, y = p1$atoms$y[3] - 3.25, symbol = "S") %>%
add_hashed_bond(from_id = 15, to_id = 3, width = 0.28, shorten = c(0.5, 0.5), colour = "black", wedge_thickness = .25, n_hashes = 6) %>%
ggchemplot2(H_offset = c(0.9, 1))
