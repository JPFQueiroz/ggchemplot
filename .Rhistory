collapse_hydrogens = TRUE,
normalize = TRUE, target_bond_length = 1,
label_size = label_size,
atom_size = 10*0.353*2.5,
H_offset = c(
-0.01250 + 0.02969 * label_size * 1.5,
0.06375 + 0.03000 * label_size * 1.55,
0.06375 + 0.03000 * label_size * 1.75,
0.06375 + 0.03000 * label_size * 1.75
)
) %>%
place_collapsed_h(atom_id = 7, side = "down") %>%
uncollapse_hydrogens(atom_id = c(16, 22)) %>%
flip_double_bond_side(from_id = 5, to_id = 6, side = -1) %>%
add_atom_note(atom_id = 4,
label = "5",
distance = 0.5,
direction = 270) %>%
add_atom_note(atom_id = 16,
label = "10",
distance = 0.5,
direction = 315) %>%
show_atom_label(atom_id = 22)
# Polish the plot
p1$atoms$color[18] <- "#CC3311"
p1$atoms$x[17] <- p1$atoms$x[17]+0.2
# Final plot
p2 <-
p1 %>% ggchemplot2(show_ids = FALSE)
save_chemplot(result = p1,
plot = p2,
filename = "HcgG_structure/ggchemplot/formylH4MPT_R2.svg",
bond_length = 0.75,
device = grDevices::svg)
