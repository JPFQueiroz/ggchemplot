library(ggplot2)
library(grImport2)
W <- 15
H <- 18
svg_size_cm <- function(path) {
raw <- paste(readLines(path, warn = FALSE), collapse = "\n")
wnum <- as.numeric(sub('(?s).*?\\bwidth="([0-9.]+).*',  "\\1", raw, perl = TRUE))
hnum <- as.numeric(sub('(?s).*?\\bheight="([0-9.]+).*', "\\1", raw, perl = TRUE))
wunit <- sub('(?s).*?\\bwidth="[0-9.]+([a-z]*).*', "\\1", raw, perl = TRUE)
to_cm <- function(val, unit) {
unit <- trimws(unit)
if (unit == "cm") val
else if (unit == "mm") val / 10
else if (unit == "in") val * 2.54
else val * 2.54 / 72
}
c(to_cm(wnum, wunit), to_cm(hnum, wunit))
}
add_mol <- function(p, path, x, y) {
wh <- svg_size_cm(path)
pic <- try(grImport2::readPicture(path), silent = TRUE)
if (inherits(pic, "try-error")) {
stop(path, " is not Cairo SVG. Re-export with save_chemplot() / grDevices::svg().")
}
p + annotation_custom(
grImport2::pictureGrob(pic),
xmin = x, xmax = x + wh[1],
ymin = y, ymax = y + wh[2]
)
}
fig <- ggplot() +
coord_fixed(xlim = c(0, W), ylim = c(0, H), expand = FALSE, clip = "off") +
theme_void() +
theme(plot.margin = margin(5, 5, 5, 5, "mm"))
fig <- fig |>
add_mol("HcgG_structure/ggchemplot/formylMFR_R1.svg",
x = 1.0, y = 12.0) |>
add_mol("HcgG_structure/ggchemplot/formylH4MPT_R2.svg",
x = 6.5, y = 13.0) |>
add_mol("HcgG_structure/ggchemplot/methenylH4MPT_R2.svg",
x = 11.0, y = 12.5)
print(fig)
ggsave(
"HcgG_structure/ggchemplot/methanogenesis.svg",
plot   = fig,
width  = W,
height = H,
units  = "cm",
device = grDevices::svg,
bg     = "white"
)
ggsave(
"HcgG_structure/ggchemplot/methanogenesis.svg",
plot   = fig,
width  = W,
height = H,
units  = "cm",
device = grDevices::svg,
bg     = NULL
)
svg_size_cm("HcgG_structure/ggchemplot/formylMFR_R1.svg")
